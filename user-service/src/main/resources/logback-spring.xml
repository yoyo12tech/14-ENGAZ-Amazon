<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ── Console appender (standard Spring Boot format) ───────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ} %5p [${spring.application.name:-user-service}] [%t] %logger{36} : %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── Root logger ───────────────────────────────────────────────────── -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- ── Reduce Hibernate SQL noise in production ──────────────────────── -->
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>

</configuration>