<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ── Console appender (local dev) ─────────────────────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ} %5p [user-service] [corrId=%X{correlationId:-none}] [%t] %logger{36} : %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── Loki4J 2.x appender — pushes structured JSON logs to Grafana Loki ── -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://loki.monitoring.svc.cluster.local:3100/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <pattern>app=amazon,service=user-service,level=%level,env=k8s</pattern>
            </label>
            <message>
                <pattern>{ "timestamp": "%d{ISO8601}", "level": "%level", "service": "user-service", "thread": "%thread", "logger": "%logger{36}", "correlationId": "%X{correlationId:-}", "userId": "%X{userId:-}", "routingKey": "%X{routingKey:-}", "message": "%msg" }</pattern>
            </message>
            <sortByTime>true</sortByTime>
        </format>
    </appender>

    <!-- ── Spring profile switching: LOKI only in k8s, CONSOLE otherwise ── -->
    <springProfile name="k8s">
        <root level="INFO">
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>

    <springProfile name="!k8s">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ── Reduce Hibernate SQL noise ───────────────────────────────────── -->
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>

</configuration>
