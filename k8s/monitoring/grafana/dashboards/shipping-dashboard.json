{
  "title": "Shipping Service Dashboard",
  "tags": ["shipping-service"],
  "style": "dark",
  "schemaVersion": 38,
  "editable": true,
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "version": 1,
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [

    {
      "id": 1,
      "title": "Error Rate (ERROR logs/min)",
      "description": "Count of ERROR-level log lines from shipping-service per minute. Spike = something is wrong.",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({app=\"amazon\", service=\"shipping-service\", level=\"ERROR\"} [1m]))"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },

    {
      "id": 2,
      "title": "RabbitMQ Event Audit (Consumed Events)",
      "description": "Log lines emitted by the consumer per routing key — order.placed, order.completed, order.cancelled.",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (routingKey) (count_over_time({app=\"amazon\", service=\"shipping-service\"} | json | routingKey != \"\" [5m]))"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },

    {
      "id": 3,
      "title": "Feign Call Outcomes (Success vs Failure)",
      "description": "Log lines for successful Feign calls vs FeignException catches to order-service.",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "Success",
          "expr": "sum(count_over_time({app=\"amazon\", service=\"shipping-service\"} |= \"returned successfully\" [5m]))"
        },
        {
          "refId": "B",
          "legendFormat": "Failure",
          "expr": "sum(count_over_time({app=\"amazon\", service=\"shipping-service\"} |= \"Feign call\" |= \"failed\" [5m]))"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
    },

    {
      "id": 4,
      "title": "HTTP Request Rate by Endpoint",
      "description": "Requests per second per URI for shipping-service.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"shipping-service\"}[5m])) by (uri)"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },

    {
      "id": 5,
      "title": "HTTP P95 Latency by Endpoint",
      "description": "95th percentile latency per endpoint.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"shipping-service\"}[5m])) by (le, uri))"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    },

    {
      "id": 6,
      "title": "JVM Heap Usage",
      "description": "Heap memory used bytes — watch for memory pressure before OOM.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_memory_used_bytes{job=\"shipping-service\", area=\"heap\"}"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 }
    }

  ]
}